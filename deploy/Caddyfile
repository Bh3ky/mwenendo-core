# Caddy gets and renews a Let's Encrypt certificate for {$DOMAIN} on its own.
# {$DOMAIN} is read from the environment (see docker-compose.prod.yml).
{$DOMAIN} {
	encode zstd gzip

	# Metrics are for the monitoring system, not the public internet.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy app:8000
}
