# Copy to .env.production on the server and fill in every value. Never commit
# the real file. Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# The public name of the site, with no https:// in front. It must already point
# at the server's public IP address, or the certificate cannot be issued.
DOMAIN=your-name.duckdns.org

SECRET_KEY=change-me
DEBUG=False
# The domain, plus 127.0.0.1 so the container's own health check is accepted.
ALLOWED_HOSTS=your-name.duckdns.org,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-name.duckdns.org
BEHIND_TLS_PROXY=True

POSTGRES_DB=mwenendo
POSTGRES_USER=mwenendo
POSTGRES_PASSWORD=change-me

# Optional. If set, /metrics needs "Authorization: Bearer <token>" (it is also
# blocked at the proxy).
METRICS_TOKEN=

LOG_LEVEL=INFO
RESERVATION_TTL_MINUTES=15
